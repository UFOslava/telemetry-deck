# Telemetry Deck - environment variables
# Copy to .env and fill in your own values:   cp .env.example .env

# Required: TomTom Maps API key  (https://developer.tomtom.com/)
TomTom_API_Key=

# --- Optional tuning (defaults shown; read by backend/app/config.py) ---
# CENTER_LAT=32.6595
# CENTER_LON=35.1090
# RADIUS_KM=10.0
# ELEVATION_SCALE=2.0
# TRAFFIC_POLL_INTERVAL=300
# TRANSIT_POLL_INTERVAL=30
# WEATHER_POLL_INTERVAL=600
